# Copy to .env and fill in. Never commit .env.

# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# --- Optional: any OpenAI-compatible provider (leave empty for OpenAI) ---
OPENAI_BASE_URL=
# Use a separate key/provider for embeddings only (falls back to the two values above)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Models ---
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Storage (relative to the working directory) ---
CHROMA_PATH=data/chroma
UPLOAD_DIR=data/uploads

# --- RAG parameters (characters, not tokens) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4

# --- Misc ---
MAX_UPLOAD_MB=20
EMBEDDING_BATCH_SIZE=64
LOG_LEVEL=INFO
